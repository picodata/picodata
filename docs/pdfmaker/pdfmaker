REMOVE_BLOCK_RE = re.compile(
    r"^\s*(?:См\.?\s+также|Читайте\s+далее|Читать\s+далее)\s*:?.*$",
    re.IGNORECASE,
)
INLINE_REMOVE_RE = re.compile(
    r"(?:^|\s)(?:См\.?\s+также|Читайте\s+далее|Читать\s+далее)\s*:?.*$",
    re.IGNORECASE | re.DOTALL,
)


class PdfmakerError(Exception):
