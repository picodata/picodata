def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="pdfmaker",
        description="Создаёт PDF из указанных поддиректорий документации Picodata.",
    )
    parser.add_argument(
        "-o",
        "--operator",
        action="store_true",
        help="создать документ типа 'Руководство оператора'",
    )
    parser.add_argument(
        "-a",
        "--admin",
        action="store_true",
        help="создать документ типа 'Руководство администратора'",
    )
    parser.add_argument(
        "--pdf",
        metavar="PATH",
        help="путь к выходному PDF-файлу",
    )
    parser.add_argument(
        "--keep-html",
        metavar="PATH",
        help="сохранить промежуточный HTML для отладки",
    )
    parser.add_argument(
        "--wide-table-mode",
        choices=("scale", "vertical"),
        default="scale",
        help=(
            "как автоматически уплотнять широкие Markdown-таблицы в PDF: "
            "scale — уменьшать шрифт, vertical — поворачивать заголовки столбцов"
        ),
    )
    parser.add_argument(
        "sections",
        nargs="*",
        help="поддиректории с документацией, например: admin architecture dev",
    )

    args = parser.parse_args(argv)

    if args.operator and args.admin:
        parser.error("укажите только один тип выходного документа: -o или -a")
    if not args.operator and not args.admin:
        parser.error(
            "не указан тип выходного документа: добавьте -o для Руководства "
            "оператора или -a для Руководства администратора"
        )
    if not args.sections:
        parser.error(
            "не указаны поддиректории с документацией, например: "
            "pdfmaker -a admin"
        )

    args.doc_type = "operator" if args.operator else "admin"
    return args


def normalize_section(value: str) -> Path:
    raw = value.strip()
    if raw.endswith("/index.html"):
        raw = raw[: -len("/index.html")]
    raw = raw.strip("/")

    rel_path = Path(raw)
    if not raw or rel_path.is_absolute() or ".." in rel_path.parts:
        raise PdfmakerError(f"некорректная поддиректория: {value!r}")

    full_path = (ROOT / rel_path).resolve()
    try:
        full_path.relative_to(ROOT)
    except ValueError as exc:
        raise PdfmakerError(f"поддиректория вне каталога документации: {value}") from exc

    if not full_path.is_dir():
        raise PdfmakerError(f"поддиректория не найдена: {value}")
    return full_path


def normalize_config_page(value: str) -> Path:
    raw = value.strip()
    if raw.endswith("/index.html"):
        raw = raw[: -len("/index.html")]
    raw = raw.strip("/")

    rel_path = Path(raw)
    if not raw or rel_path.is_absolute() or ".." in rel_path.parts:
        raise PdfmakerError(f"некорректный раздел в excluded_sections: {value!r}")

    index_html = (ROOT / rel_path / "index.html").resolve()
    try:
        index_html.relative_to(ROOT)
    except ValueError as exc:
        raise PdfmakerError(
            f"раздел в excluded_sections вне каталога документации: {value}"
        ) from exc

    if not index_html.is_file():
        raise PdfmakerError(
            f"раздел в excluded_sections не найден: {value} (ожидался index.html)"
        )
    return index_html


def page_id(index_html: Path) -> str:
    rel = index_html.relative_to(ROOT).as_posix()
    suffix = "/index.html"
    if rel.endswith(suffix):
        return rel[: -len(suffix)]
    if rel == "index.html":
        return ""
    return rel


def normalize_text_pattern(value: object) -> str:
    return re.sub(r"\s+", " ", str(value).replace("\xa0", " ")).strip()


def parse_excluded_sections(raw: object) -> dict[str, list[str]]:
    if raw is None:
        return {}
    if not isinstance(raw, dict):
        raise PdfmakerError("блок excluded_sections должен быть словарём")

    result: dict[str, list[str]] = {}
    for section, section_ids in raw.items():
        if not isinstance(section, str) or not section.strip():
            raise PdfmakerError(
                "ключи в excluded_sections должны быть непустыми строками"
            )
        if not isinstance(section_ids, list):
            raise PdfmakerError(
                f"значение excluded_sections.{section} должно быть списком id"
            )

        index_html = normalize_config_page(section)
        source_id = page_id(index_html)
        parsed_ids: list[str] = []
        for section_id in section_ids:
            if not isinstance(section_id, str) or not section_id.strip():
                raise PdfmakerError(
                    f"в excluded_sections.{section} должен быть список непустых строк"
                )
            parsed_ids.append(section_id.strip().lstrip("#"))

        result.setdefault(source_id, []).extend(parsed_ids)
    return result


def parse_excluded_lines(raw: object) -> list[str]:
    if raw is None:
        return []
    if isinstance(raw, list):
        candidates = raw
    else:
        candidates = [raw]
    return [
        pattern
        for pattern in map(normalize_text_pattern, candidates)
        if pattern
    ]


def load_article(index_html: Path):
    try:
        source = index_html.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as exc:
        raise PdfmakerError(f"не удалось прочитать {index_html}: {exc}") from exc

    soup = BeautifulSoup(source, "html.parser")
    article = soup.select_one("article.md-content__inner")
    if article is None:
        raise PdfmakerError(f"не найден основной контент: {index_html}")
    return article


def heading_id_matches(
    source_id: str,
    actual_id: str | None,
    requested_id: str,
) -> bool:
    if not actual_id:
        return False
    return requested_id == actual_id or requested_id == f"{source_id}/{actual_id}"


def find_section_heading(article, source_id: str, requested_id: str):
    for heading in article.find_all(list(SECTION_HEADING_LEVELS)):
        if heading_id_matches(source_id, heading.get("id"), requested_id):
            return heading
    return None


def validate_excluded_sections(config: PdfmakerConfig) -> None:
    for source_id, section_ids in config.excluded_sections.items():
        index_html = ROOT / source_id / "index.html"
        article = load_article(index_html)
        available_ids = [
            heading.get("id")
            for heading in article.find_all(list(SECTION_HEADING_LEVELS))
            if heading.get("id")
        ]

        for section_id in section_ids:
            if find_section_heading(article, source_id, section_id) is not None:
                continue

            sample = ", ".join(available_ids[:10]) or "нет h2-h5 с id"
            raise PdfmakerError(
                f"{config.path}: в excluded_sections.{source_id} не найден "
                f"подраздел с id {section_id!r}. Доступные id: {sample}"
            )


def load_pdfmaker_config() -> PdfmakerConfig:
    config_path = Path.cwd() / CONFIG_FILENAME
    if not config_path.exists():
        return PdfmakerConfig()

    try:
        import yaml
    except ImportError as exc:  # pragma: no cover - startup diagnostic
        raise PdfmakerError(
            f"найден {config_path}, но для YAML-конфигурации нужен пакет PyYAML"
        ) from exc

    try:
        raw_config = yaml.safe_load(config_path.read_text(encoding="utf-8"))
    except Exception as exc:
        raise PdfmakerError(f"не удалось разобрать {config_path}: {exc}") from exc

    if raw_config is None:
        raw_config = {}
    if not isinstance(raw_config, dict):
        raise PdfmakerError(
            f"{config_path}: верхний уровень YAML должен быть словарём"
        )

    config = PdfmakerConfig(
        path=config_path,
        excluded_sections=parse_excluded_sections(raw_config.get("excluded_sections")),
        excluded_lines=parse_excluded_lines(raw_config.get("excluded_lines")),
    )
    validate_excluded_sections(config)
    return config


def load_toc_order() -> dict[str, int]:
    toc_path = ROOT / "picodata_docs.html"
    if not toc_path.exists():
        return {}

    soup = BeautifulSoup(toc_path.read_text(encoding="utf-8"), "html.parser")
    order: dict[str, int] = {}
    for anchor in soup.select("article.pd-toc a[href]"):
        href = anchor.get("href", "").lstrip("#").strip("/")
        if not href or href in order:
            continue
        if (ROOT / href / "index.html").exists():
            order[href] = len(order)
    return order


def collect_pages(sections: list[str], toc_order: dict[str, int]) -> list[Path]:
    pages: list[Path] = []
    seen: set[Path] = set()

    for section in sections:
        section_dir = normalize_section(section)
        section_pages = list(section_dir.rglob("index.html"))
        section_pages.sort(
            key=lambda path: (
                toc_order.get(identifier := page_id(path), 1_000_000),
                identifier,
            )
        )
        if not section_pages:
            raise PdfmakerError(f"в поддиректории нет страниц index.html: {section}")

        for path in section_pages:
            resolved = path.resolve()
            if resolved not in seen:
                pages.append(resolved)
                seen.add(resolved)

    return pages


def is_blank(node) -> bool:
    return isinstance(node, NavigableString) and not str(node).strip()


def remove_related_blocks(article) -> None:
    for tag in list(article.find_all(["p", "div"])):
        text = tag.get_text(" ", strip=True).replace("\xa0", " ")
        if not REMOVE_BLOCK_RE.match(text):
            continue

        sibling = tag.next_sibling
        tag.decompose()

        while sibling is not None:
            next_sibling = sibling.next_sibling
            if is_blank(sibling):
                sibling.extract()
            elif getattr(sibling, "name", None) in {"ul", "ol"}:
                sibling.decompose()
            else:
                break
            sibling = next_sibling


def remove_following_inside(container, node) -> None:
    current = node
    while current is not None and current is not container:
        for sibling in list(current.next_siblings):
            sibling.extract()
        current = current.parent


def trim_inline_related_text(article) -> None:
    for tag in list(article.find_all(["p", "li"])):
        for text_node in list(tag.find_all(string=True)):
            match = INLINE_REMOVE_RE.search(str(text_node))
            if not match:
                continue

            prefix = NavigableString(str(text_node)[: match.start()].rstrip())
            text_node.replace_with(prefix)
            remove_following_inside(tag, prefix)
            break


def remove_node(node) -> None:
    if hasattr(node, "decompose"):
        node.decompose()
    else:
        node.extract()


def remove_section_from_heading(heading) -> None:
    heading_level = SECTION_HEADING_LEVELS[heading.name]
    current = heading
    while current is not None:
        next_sibling = current.next_sibling
        current_level = SECTION_HEADING_LEVELS.get(getattr(current, "name", None))
        if (
            current is not heading
            and current_level is not None
            and current_level <= heading_level
        ):
            break

        remove_node(current)
        current = next_sibling


def remove_excluded_sections(article, source_id: str, section_ids: list[str]) -> None:
    for section_id in section_ids:
        heading = find_section_heading(article, source_id, section_id)
        if heading is None:
            continue
        remove_section_from_heading(heading)


def remove_excluded_line_paragraphs(article, patterns: list[str]) -> None:
    if not patterns:
        return

    for paragraph in list(article.find_all("p")):
        text = normalize_text_pattern(paragraph.get_text(" ", strip=True))
        if any(pattern in text for pattern in patterns):
            paragraph.decompose()


def replace_missing_image(tag, label: str) -> None:
    placeholder = BeautifulSoup(
        f'<p class="missing-image">[{html.escape(label)}]</p>', "html.parser"
    ).p
    tag.replace_with(placeholder)


def rewrite_local_resource(tag, attr: str, source_dir: Path) -> None:
    value = tag.get(attr)
    if not value or value.startswith("data:"):
        return

    parsed = urlparse(value)
    if parsed.scheme in {"http", "https"}:
        label = tag.get("alt") or value
        replace_missing_image(tag, f"Изображение недоступно: {label}")
        return
    if parsed.scheme and parsed.scheme != "file":
        return

    local_part = unquote(parsed.path)
    if not local_part:
        return

    # A leading slash in generated HTML denotes the documentation root, not
    # the host filesystem root.  file:// URLs, on the other hand, are absolute.
    if parsed.scheme == "file":
        resource_path = Path(local_part).resolve()
    elif local_part.startswith("/"):
        resource_path = (ROOT / local_part.lstrip("/")).resolve()
    else:
        resource_path = (source_dir / local_part).resolve()

    try:
        resource_path.relative_to(ROOT)
    except ValueError:
        label = tag.get("alt") or local_part
        replace_missing_image(tag, f"Изображение вне каталога документации: {label}")
        return

    if resource_path.is_file():
        tag[attr] = resource_path.as_uri()
    else:
        label = tag.get("alt") or local_part
        replace_missing_image(tag, f"Изображение не найдено: {label}")


def clean_article(index_html: Path, config: PdfmakerConfig) -> str:
    source_id = page_id(index_html)
    article = load_article(index_html)

    for selector in [
        "nav",
        "form",
        "script",
        "style",
        ".md-content__button",
        ".md-feedback",
        ".md-dialog",
        ".headerlink",
    ]:
        for tag in list(article.select(selector)):
            tag.decompose()

    for anchor in list(article.find_all("a")):
        if not anchor.get_text(strip=True) and not anchor.find("img"):
            anchor.decompose()
            continue
        anchor.unwrap()

    remove_excluded_sections(article, source_id, config.excluded_sections.get(source_id, []))
    remove_excluded_line_paragraphs(article, config.excluded_lines)
    remove_related_blocks(article)
    trim_inline_related_text(article)

    for tag in list(article.find_all(["img", "embed", "source"])):
        rewrite_local_resource(tag, "src", index_html.parent)
    for tag in list(article.find_all(["object"])):
        rewrite_local_resource(tag, "data", index_html.parent)

    for tag in list(article.find_all(["p", "li", "td", "th"])):
        if tag.get_text(strip=True) or tag.find(["img", "table", "pre", "code"]):
            continue
        tag.decompose()

    rel = html.escape(source_id, quote=True)
    title = article.find("h1")
    title_text = title.get_text(" ", strip=True) if title else source_id
    print(f"Добавлена страница: {source_id} — {title_text}", flush=True)
    return f'<section class="doc-article" data-source="{rel}">{article.decode_contents()}</section>'


def css_string(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ")


def build_cover(document_title: str) -> str:
    logo_path = ROOT / "assets" / "pdficon.svg"
    logo = ""
    if logo_path.exists():
        logo = (
            f'<img class="cover-logo" src="{html.escape(logo_path.as_uri(), quote=True)}" '
            'alt="Picodata logo">'
        )

    return f"""
<section class="cover">
  <div class="cover-brand">
    {logo}
    <span>Picodata</span>
  </div>
  <h1>{html.escape(document_title)}</h1>
</section>
"""


