def make_doc_template(output_pdf: Path, document_title: str, fonts: dict[str, str]):
    from reportlab.lib.pagesizes import A4
    from reportlab.lib.units import mm
    from reportlab.platypus import Paragraph, SimpleDocTemplate

    class TocDocTemplate(SimpleDocTemplate):
        toc_levels = {"H1": 0, "H2": 1, "H3": 2}

        def afterFlowable(self, flowable):
            if not isinstance(flowable, Paragraph):
                return
            level = self.toc_levels.get(flowable.style.name)
            if level is None:
                return
            text = flowable.getPlainText()
            if text:
                self.notify("TOCEntry", (level, text, self.page))

    return TocDocTemplate(
        str(output_pdf),
        pagesize=A4,
        rightMargin=16 * mm,
        leftMargin=16 * mm,
        topMargin=22 * mm,
        bottomMargin=18 * mm,
        title=document_title,
    )


def inline_markup(node, ctx: ReportContext) -> str:
    if isinstance(node, NavigableString):
        return html.escape(re.sub(r"\s+", " ", str(node)))

    name = getattr(node, "name", "")
    if not name:
        return ""
    if name == "br":
        return "<br/>"
    if name in {"script", "style", "nav", "form"}:
        return ""
    if name in {"strong", "b"}:
        return f"<b>{inline_children(node, ctx)}</b>"
    if name in {"em", "i"}:
        return f"<i>{inline_children(node, ctx)}</i>"
    if name == "code":
        text = html.escape(node.get_text("", strip=False))
        return f'<font name="{ctx.fonts["mono"]}">{text}</font>'
    if name == "sup":
        return f"<super>{inline_children(node, ctx)}</super>"
    if name == "sub":
        return f"<sub>{inline_children(node, ctx)}</sub>"
    if name == "img":
        return html.escape(node.get("alt") or "")
    return inline_children(node, ctx)


def inline_children(tag, ctx: ReportContext) -> str:
    return "".join(inline_markup(child, ctx) for child in tag.children)


def paragraph_from_markup(markup: str, style):
    from reportlab.platypus import Paragraph

    markup = markup.strip()
    if not markup:
        return None
    return Paragraph(markup, style)


def table_paragraph_style(
    ctx: ReportContext,
    name: str,
    font_size: float,
    leading: float,
    *,
    bold: bool = False,
    mono: bool = False,
    alignment: int = 0,
):
    from reportlab.lib.styles import ParagraphStyle

    if mono:
        font_name = ctx.fonts["mono"]
    elif bold:
        font_name = ctx.fonts["bold"]
    else:
        font_name = ctx.fonts["regular"]

    return ParagraphStyle(
        name,
        parent=ctx.styles["table_cell"],
        fontName=font_name,
        fontSize=font_size,
        leading=leading,
        alignment=alignment,
        wordWrap="CJK",
        splitLongWords=1,
    )


def plain_table_markup(text: str) -> str:
    lines = [html.escape(line.strip()) for line in text.splitlines()]
    return "<br/>".join(line for line in lines if line) or " "


def estimate_text_width(text: str, font_name: str, font_size: float) -> float:
    from reportlab.pdfbase.pdfmetrics import stringWidth

    normalized = re.sub(r"\s+", " ", text.strip())
    if not normalized:
        return 18

    token_widths = [
        stringWidth(token, font_name, font_size)
        for token in re.split(r"[\s,;|/]+", normalized)
        if token
    ]
    longest_token = max(token_widths, default=0)
    full_line = stringWidth(normalized, font_name, font_size)

    # Prefer a readable no-wrap width, but cap long prose so it can still wrap.
    return max(22, min(max(longest_token + 8, full_line * 0.55), 170))


def table_column_count(rows: list[list[TableCellContent]]) -> int:
    return max((len(row) for row in rows), default=0)


def estimate_table_col_widths(
    rows: list[list[TableCellContent]],
    ctx: ReportContext,
    font_size: float,
    *,
    include_header: bool = True,
    mono: bool = False,
) -> list[float]:
    columns = table_column_count(rows)
    font_name = ctx.fonts["mono"] if mono else ctx.fonts["regular"]
    widths = [22.0] * columns

    for row in rows:
        for column, cell in enumerate(row):
            if cell.is_header and not include_header:
                continue
            widths[column] = max(
                widths[column],
                estimate_text_width(cell.text, font_name, font_size),
            )

    return widths


def is_wide_table(rows: list[list[TableCellContent]], ctx: ReportContext) -> bool:
    columns = table_column_count(rows)
    if columns < 4:
        return False

    preferred_widths = estimate_table_col_widths(rows, ctx, TABLE_FONT_SIZE)
    natural_width = sum(preferred_widths)
    equal_column_width = ctx.doc_width / columns

    if columns >= 7 and equal_column_width < 74:
        return True
    if columns >= WIDE_TABLE_MIN_COLUMNS and natural_width > ctx.doc_width * 1.05:
        return True
    return natural_width > ctx.doc_width * 1.35


def fitted_col_widths(preferred_widths: list[float], total_width: float) -> list[float]:
    columns = len(preferred_widths)
    if not columns:
        return []

    floor = min(32, total_width / columns * 0.7)
    widths = [max(width, floor) for width in preferred_widths]
    width_sum = sum(widths)

    if width_sum <= total_width:
        extra = (total_width - width_sum) / columns
        return [width + extra for width in widths]

    flexible = sum(max(width - floor, 0) for width in widths)
    if flexible <= 0:
        return [total_width / columns] * columns

    excess = width_sum - total_width
    fitted = [
        width - excess * max(width - floor, 0) / flexible
        for width in widths
    ]
    scale = total_width / sum(fitted)
    return [width * scale for width in fitted]


def rotated_paragraph(markup: str, text: str, style):
    from reportlab.platypus import Flowable, Paragraph

    class RotatedParagraph(Flowable):
        def __init__(self, markup: str, text: str, style):
            super().__init__()
            self.markup = markup
            self.text = text
            self.style = style
            self.paragraph = Paragraph(markup, style)
            self.paragraph_width = 0
            self.paragraph_height = 0

        def wrap(self, avail_width, _avail_height):
            font_name = getattr(self.style, "fontName", "Helvetica")
            font_size = getattr(self.style, "fontSize", WIDE_TABLE_VERTICAL_FONT_SIZE)
            natural_width = estimate_text_width(self.text, font_name, font_size)
            paragraph_width = max(24, min(145, natural_width))
            self.paragraph_width, self.paragraph_height = self.paragraph.wrap(
                paragraph_width,
                max(avail_width, 18),
            )
            self.width = max(14, min(avail_width, self.paragraph_height + 1))
            self.height = self.paragraph_width
            return self.width, self.height

        def draw(self):
            offset = max((self.width - self.paragraph_height) / 2, 0)
            self.canv.saveState()
            self.canv.translate(offset + self.paragraph_height, 0)
            self.canv.rotate(90)
            self.paragraph.drawOn(self.canv, 0, 0)
            self.canv.restoreState()

    return RotatedParagraph(markup, text, style)


def looks_like_markdown_table(tag) -> bool:
    if tag.get("class") or tag.get("id"):
        return False
    if tag.find(["button", "input", "select", "textarea", "script", "style"]):
        return False
    for cell in tag.find_all(["th", "td"]):
        if cell.get("rowspan") or cell.get("colspan"):
            return False
    return bool(tag.find("th"))


def table_flowables_from_rows(
    rows: list[list[TableCellContent]],
    first_row_is_header: bool,
    ctx: ReportContext,
    *,
    wide_candidate: bool,
    force_wide: bool = False,
    mono: bool = False,
) -> list:
    from reportlab.lib import colors
    from reportlab.platypus import Paragraph, Table, TableStyle

    if not rows:
        return []

    columns = table_column_count(rows)
    for row in rows:
        while len(row) < columns:
            row.append(TableCellContent(" ", " "))

    wide = force_wide or (wide_candidate and is_wide_table(rows, ctx))
    mode = ctx.wide_table_mode if wide else "normal"
    if mode == "vertical" and not first_row_is_header:
        mode = "scale"

    font_size = TABLE_FONT_SIZE
    leading = TABLE_LEADING
    left_padding = right_padding = 4
    top_padding = bottom_padding = 3
    include_header_in_widths = True

    if mode == "scale":
        preferred = estimate_table_col_widths(
            rows,
            ctx,
            TABLE_FONT_SIZE,
            include_header=True,
            mono=mono,
        )
        scale = min(1.0, ctx.doc_width / max(sum(preferred), 1))
        font_size = max(WIDE_TABLE_MIN_FONT_SIZE, TABLE_FONT_SIZE * scale)
        leading = max(font_size + 1.2, TABLE_LEADING * scale)
        left_padding = right_padding = max(1.8, 4 * scale)
        top_padding = bottom_padding = max(1.6, 3 * scale)
    elif mode == "vertical":
        font_size = WIDE_TABLE_VERTICAL_FONT_SIZE
        leading = font_size + 1.4
        left_padding = right_padding = 2.2
        top_padding = bottom_padding = 2
        include_header_in_widths = False

    cell_style = table_paragraph_style(
        ctx,
        f"TableCell-{mode}-{font_size:.2f}",
        font_size,
        leading,
        mono=mono,
    )
    header_style = table_paragraph_style(
        ctx,
        f"TableHeader-{mode}-{font_size:.2f}",
        font_size,
        leading,
        bold=True,
        mono=mono,
    )

    preferred_widths = estimate_table_col_widths(
        rows,
        ctx,
        font_size,
        include_header=include_header_in_widths,
        mono=mono,
    )
    if not any(width > 22 for width in preferred_widths):
        preferred_widths = estimate_table_col_widths(
            rows,
            ctx,
            font_size,
            include_header=True,
            mono=mono,
        )
    col_widths = (
        fitted_col_widths(preferred_widths, ctx.doc_width)
        if wide
        else [ctx.doc_width / columns] * columns
    )

    table_rows = []
    for row_index, row in enumerate(rows):
        rendered_row = []
        for cell in row:
            style = header_style if cell.is_header else cell_style
            if mode == "vertical" and row_index == 0 and first_row_is_header:
                rendered_row.append(rotated_paragraph(cell.markup, cell.text, style))
            else:
                rendered_row.append(Paragraph(cell.markup, style))
        table_rows.append(rendered_row)

    table = Table(
        table_rows,
        colWidths=col_widths,
        repeatRows=1 if first_row_is_header else 0,
        splitByRow=True,
    )
    style = TableStyle(
        [
            ("GRID", (0, 0), (-1, -1), 0.35, colors.HexColor("#d8dee4")),
            ("VALIGN", (0, 0), (-1, -1), "TOP"),
            ("LEFTPADDING", (0, 0), (-1, -1), left_padding),
            ("RIGHTPADDING", (0, 0), (-1, -1), right_padding),
            ("TOPPADDING", (0, 0), (-1, -1), top_padding),
            ("BOTTOMPADDING", (0, 0), (-1, -1), bottom_padding),
        ]
    )
    if first_row_is_header:
        style.add("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#f2f4f7"))
        style.add("FONTNAME", (0, 0), (-1, 0), ctx.fonts["bold"])
        style.add("VALIGN", (0, 0), (-1, 0), "BOTTOM" if mode == "vertical" else "TOP")
    table.setStyle(style)
    return [table]


def text_flowables(tag, ctx: ReportContext, style=None) -> list:
    style = style or ctx.styles["body"]
    para = paragraph_from_markup(inline_children(tag, ctx), style)
    return [para] if para else []


def code_preformatted_flowable(text: str, ctx: ReportContext):
    from reportlab.lib.styles import ParagraphStyle
    from reportlab.pdfbase.pdfmetrics import stringWidth
    from reportlab.platypus import Preformatted

    base_style = ctx.styles["code"]
    lines_source = text.strip("\n").splitlines() or [""]
    available_width = max(
        60,
        ctx.doc_width
        - base_style.leftIndent
        - base_style.rightIndent
        - base_style.borderPadding * 2,
    )
    longest_width = max(
        stringWidth(line, ctx.fonts["mono"], base_style.fontSize)
        for line in lines_source
    )

    style = base_style
    if longest_width > available_width:
        scale = max(0.62, available_width / longest_width)
        font_size = max(4.8, base_style.fontSize * scale)
        style = ParagraphStyle(
            "CodeWide",
            parent=base_style,
            fontSize=font_size,
            leading=max(font_size + 1.4, base_style.leading * scale),
        )

    char_width = max(stringWidth("M", ctx.fonts["mono"], style.fontSize), 1)
    max_chars = max(42, int(available_width / char_width))
    lines = []
    for line in lines_source:
        if len(line) <= max_chars:
            lines.append(line)
            continue
        prefix = re.match(r"^\s*", line).group(0)
        width = max(40, max_chars - len(prefix))
        chunks = [line[i : i + width] for i in range(0, len(line), width)]
        lines.append(chunks[0])
        lines.extend(prefix + chunk for chunk in chunks[1:])
    return Preformatted("\n".join(lines), style)


def is_ascii_table_top(line: str) -> bool:
    stripped = line.rstrip()
    return (
        stripped.startswith("+")
        and stripped.endswith("+")
        and stripped.count("+") >= 3
        and set(stripped) <= set("+-= ")
    )


def is_ascii_table_line(line: str) -> bool:
    stripped = line.rstrip()
    if not stripped:
        return False
    if stripped.startswith("|") and stripped.endswith("|"):
        return True
    return is_ascii_table_top(stripped) or is_ascii_table_separator(stripped)


def is_ascii_table_separator(line: str) -> bool:
    stripped = line.rstrip()
    return (
        bool(stripped)
        and stripped[0] in "+|"
        and stripped[-1] in "+|"
        and "+" in stripped
        and set(stripped) <= set("+-=| ")
    )


def split_ascii_table_row(line: str, boundaries: list[int]) -> list[str]:
    padded = line.rstrip().ljust(boundaries[-1] + 1)
    return [
        padded[boundaries[index] + 1 : boundaries[index + 1]].strip()
        for index in range(len(boundaries) - 1)
    ]


def parse_ascii_table_block(lines: list[str]) -> tuple[list[list[TableCellContent]], bool] | None:
    if not lines or not is_ascii_table_top(lines[0]):
        return None

    top = lines[0].rstrip()
    boundaries = [index for index, char in enumerate(top) if char == "+"]
    columns = len(boundaries) - 1
    if columns < ASCII_TABLE_MIN_COLUMNS:
        return None

    rows: list[list[str]] = []
    current_row: list[str] | None = None
    first_row_is_header = False

    for line in lines[1:]:
        stripped = line.rstrip()
        if is_ascii_table_separator(stripped):
            if current_row is not None:
                rows.append(current_row)
                current_row = None
            if "=" in stripped and rows:
                first_row_is_header = True
            continue
        if not (stripped.startswith("|") and stripped.endswith("|")):
            continue

        cells = split_ascii_table_row(stripped, boundaries)
        if current_row is None:
            current_row = [""] * columns
        for index, value in enumerate(cells):
            if not value:
                continue
            current_row[index] = (
                f"{current_row[index]}\n{value}" if current_row[index] else value
            )

    if current_row is not None:
        rows.append(current_row)
    if not rows:
        return None

    table_rows = [
        [
            TableCellContent(
                plain_table_markup(cell),
                re.sub(r"\s+", " ", cell.strip()),
                is_header=first_row_is_header and row_index == 0,
            )
            for cell in row
        ]
        for row_index, row in enumerate(rows)
    ]
    return table_rows, first_row_is_header


def code_flowables(text: str, ctx: ReportContext) -> list:
    source_lines = text.strip("\n").splitlines()
    segments = []
    code_lines: list[str] = []
    index = 0

    while index < len(source_lines):
        line = source_lines[index]
        if is_ascii_table_top(line):
            end = index + 1
            while end < len(source_lines) and is_ascii_table_line(source_lines[end]):
                end += 1

            parsed = parse_ascii_table_block(source_lines[index:end])
            if parsed is not None:
                rows, first_row_is_header = parsed
                if is_wide_table(rows, ctx):
                    if code_lines:
                        segments.append(("code", "\n".join(code_lines)))
                        code_lines = []
                    segments.append(("table", rows, first_row_is_header))
                    index = end
                    continue

        code_lines.append(line)
        index += 1

    if code_lines:
        segments.append(("code", "\n".join(code_lines)))

    if not any(segment[0] == "table" for segment in segments):
        return [code_preformatted_flowable(text, ctx)]

    flowables = []
    for segment in segments:
        if segment[0] == "code":
            code_text = segment[1]
            if code_text.strip():
                flowables.append(code_preformatted_flowable(code_text, ctx))
        else:
            _kind, rows, first_row_is_header = segment
            flowables.extend(
                table_flowables_from_rows(
                    rows,
                    first_row_is_header,
                    ctx,
                    wide_candidate=True,
                    force_wide=True,
                )
            )
    return flowables


def image_flowable(tag, ctx: ReportContext):
    from reportlab.lib.units import mm
    from reportlab.platypus import Image as RLImage
    from reportlab.platypus import Paragraph

    src = tag.get("src") or tag.get("data")
    alt = tag.get("alt") or "изображение"
    if not src:
        return Paragraph(f"[{html.escape(alt)}]", ctx.styles["caption"])

    parsed = urlparse(src)
    if parsed.scheme != "file":
        return Paragraph(f"[{html.escape(alt)}]", ctx.styles["caption"])

    image_path = Path(unquote(parsed.path))
    if not image_path.exists():
        return Paragraph(f"[{html.escape(alt)}]", ctx.styles["caption"])

    try:
        if image_path.suffix.lower() == ".svg":
            import cairosvg

            ctx.image_counter += 1
            png_path = ctx.temp_dir / f"image-{ctx.image_counter}.png"
            cairosvg.svg2png(url=str(image_path), write_to=str(png_path))
            image_path = png_path

        from PIL import Image as PILImage

        with PILImage.open(image_path) as image:
            width_px, height_px = image.size

        if width_px <= 0 or height_px <= 0:
            raise ValueError("изображение имеет нулевой размер")

        width = width_px * 0.75
        height = height_px * 0.75
        max_width = ctx.doc_width
        max_height = 210 * mm
        scale = min(max_width / width, max_height / height, 1.0)
        return RLImage(str(image_path), width=width * scale, height=height * scale)
    except Exception:
        return Paragraph(f"[{html.escape(alt)}]", ctx.styles["caption"])


def table_flowable(tag, ctx: ReportContext):
    rows = []
    first_row_is_header = False
    for row_index, tr in enumerate(tag.find_all("tr")):
        cells = tr.find_all(["th", "td"], recursive=False)
        if not cells:
            continue
        if row_index == 0 and any(cell.name == "th" for cell in cells):
            first_row_is_header = True
        rows.append(
            [
                TableCellContent(
                    cell_markup(cell, ctx),
                    re.sub(r"\s+", " ", cell.get_text(" ", strip=True)),
                    is_header=cell.name == "th",
                )
                for cell in cells
            ]
        )

    if not rows:
        return []

    return table_flowables_from_rows(
        rows,
        first_row_is_header,
        ctx,
        wide_candidate=looks_like_markdown_table(tag),
    )


def cell_markup(cell, ctx: ReportContext) -> str:
    parts = []
    for child in cell.children:
        name = getattr(child, "name", "")
        if name in {"p", "div", "ul", "ol", "pre", "table"} and parts:
            parts.append("<br/>")
        if name in {"ul", "ol"}:
            items = []
            for index, li in enumerate(child.find_all("li", recursive=False), start=1):
                marker = f"{index}." if name == "ol" else "•"
                items.append(f"{marker} {inline_children(li, ctx)}")
            parts.append("<br/>".join(items))
        elif name == "pre":
            parts.append(f'<font name="{ctx.fonts["mono"]}">{html.escape(child.get_text())}</font>')
        else:
            parts.append(inline_markup(child, ctx))
    return "".join(parts).strip() or " "


def list_flowables(tag, ctx: ReportContext, level: int = 0) -> list:
    from reportlab.lib.styles import ParagraphStyle

    flowables = []
    style = ParagraphStyle(
        f"ListLevel{level}",
        parent=ctx.styles["body"],
        leftIndent=level * 14,
        firstLineIndent=0,
        spaceAfter=4,
    )
    ordered = tag.name == "ol"

    for index, item in enumerate(tag.find_all("li", recursive=False), start=1):
        inline_parts = []
        nested_blocks = []
        for child in item.children:
            name = getattr(child, "name", "")
            if name in {"ul", "ol", "table", "pre", "div", "blockquote"}:
                nested_blocks.append(child)
            else:
                inline_parts.append(inline_markup(child, ctx))

        marker = f"{index}." if ordered else "•"
        para = paragraph_from_markup(f"{marker} {''.join(inline_parts)}", style)
        if para:
            flowables.append(para)
        for block in nested_blocks:
            flowables.extend(node_flowables(block, ctx, level + 1))
    return flowables


def node_flowables(node, ctx: ReportContext, list_level: int = 0) -> list:
    from reportlab.platypus import HRFlowable, Spacer

    if isinstance(node, NavigableString):
        if not str(node).strip():
            return []
        para = paragraph_from_markup(html.escape(str(node).strip()), ctx.styles["body"])
        return [para] if para else []

    name = getattr(node, "name", "")
    if not name:
        return []

    classes = set(node.get("class", []))
    if name in {"script", "style", "nav", "form"}:
        return []
    if name == "hr":
        return [HRFlowable(width="100%", thickness=0.4), Spacer(1, 6)]
    if name in {"h1", "h2", "h3"}:
        return text_flowables(node, ctx, ctx.styles[name])
    if name in {"h4", "h5", "h6"}:
        return text_flowables(node, ctx, ctx.styles["h4"])
    if name == "p":
        if node.find(["img", "object"], recursive=False):
            flowables = []
            for child in node.children:
                if getattr(child, "name", "") in {"img", "object"}:
                    flowables.append(image_flowable(child, ctx))
                elif isinstance(child, NavigableString) and not str(child).strip():
                    continue
                else:
                    flowables.extend(node_flowables(child, ctx, list_level))
            return flowables
        return text_flowables(node, ctx)
    if name in {"img", "object"}:
        return [image_flowable(node, ctx)]
    if name == "pre" or "highlight" in classes:
        return code_flowables(node.get_text("", strip=False), ctx)
    if name in {"ul", "ol"}:
        return list_flowables(node, ctx, list_level)
    if name == "table":
        return table_flowable(node, ctx)
    if name in {"blockquote", "details", "figure", "figcaption"} or "admonition" in classes:
        flowables = []
        if "admonition" in classes:
            flowables.append(Spacer(1, 4))
        for child in node.children:
            flowables.extend(node_flowables(child, ctx, list_level))
        if name == "figcaption":
            for flowable in flowables:
                if hasattr(flowable, "style"):
                    flowable.style = ctx.styles["caption"]
        return flowables
    if name == "dl":
        flowables = []
        for child in node.children:
            flowables.extend(node_flowables(child, ctx, list_level))
        return flowables
    if name == "dt":
        return [paragraph_from_markup(f"<b>{inline_children(node, ctx)}</b>", ctx.styles["body"])]
    if name == "dd":
        return text_flowables(node, ctx)

    flowables = []
    for child in node.children:
        flowables.extend(node_flowables(child, ctx, list_level))
    return flowables


def reportlab_article_flowables(article_html: str, ctx: ReportContext) -> list:
    soup = BeautifulSoup(article_html, "html.parser")
    section = soup.select_one("section.doc-article") or soup
    flowables = []
    for child in section.children:
        flowables.extend(node_flowables(child, ctx))
    return [flowable for flowable in flowables if flowable is not None]


def render_pdf_reportlab(
    document_title: str,
    articles: list[str],
    output_pdf: Path,
    *,
    wide_table_mode: str,
) -> None:
    from reportlab.lib.pagesizes import A4
    from reportlab.lib.units import mm
    from reportlab.platypus import Image as RLImage
    from reportlab.platypus import PageBreak, Paragraph, Spacer

    fonts = register_reportlab_fonts()
    styles = make_reportlab_styles(fonts)
    output_pdf.parent.mkdir(parents=True, exist_ok=True)

    doc = make_doc_template(output_pdf, document_title, fonts)

    def on_first_page(canvas, _doc):
        pass

    def on_later_page(canvas, _doc):
        canvas.saveState()
        canvas.setFont(fonts["regular"], 9)
        canvas.setFillColorRGB(0.37, 0.41, 0.45)
        canvas.drawCentredString(A4[0] / 2, A4[1] - 12 * mm, document_title)
        canvas.drawRightString(A4[0] - 16 * mm, 9 * mm, str(canvas.getPageNumber()))
        canvas.restoreState()

    with tempfile.TemporaryDirectory(prefix="pdfmaker-reportlab-") as tmpdir:
        temp_dir = Path(tmpdir)
        ctx = ReportContext(
            styles=styles,
            fonts=fonts,
            temp_dir=temp_dir,
            doc_width=doc.width,
            wide_table_mode=wide_table_mode,
        )
        story = [Spacer(1, 92 * mm)]

        logo_path = ROOT / "assets" / "pdficon.svg"
        if logo_path.exists():
            try:
                import cairosvg

                logo_png = temp_dir / "logo.png"
                cairosvg.svg2png(url=str(logo_path), write_to=str(logo_png), output_width=44)
                story.append(RLImage(str(logo_png), width=22, height=22))
                story.append(Spacer(1, 4))
            except Exception:
                pass

        story.append(Paragraph("Picodata", styles["cover_brand"]))
        story.append(Paragraph(f"<b>{html.escape(document_title)}</b>", styles["cover_title"]))
        story.append(PageBreak())
        story.append(Paragraph("Содержание", styles["toc_title"]))
        story.append(make_toc(fonts))
        story.append(PageBreak())

        for index, article in enumerate(articles):
            if index:
                story.append(PageBreak())
            story.extend(reportlab_article_flowables(article, ctx))

        doc.multiBuild(story, onFirstPage=on_first_page, onLaterPages=on_later_page)


def render_pdf_atomically(
    document_title: str,
    articles: list[str],
    output_pdf: Path,
    *,
    wide_table_mode: str,
) -> None:
    """Render beside the destination and publish only a complete PDF."""
    output_pdf.parent.mkdir(parents=True, exist_ok=True)
    temp_fd, temp_name = tempfile.mkstemp(
        prefix=f".{output_pdf.name}.",
        suffix=".tmp.pdf",
        dir=output_pdf.parent,
    )
    os.close(temp_fd)
    temp_pdf = Path(temp_name)
    try:
        render_pdf_reportlab(
            document_title,
            articles,
            temp_pdf,
            wide_table_mode=wide_table_mode,
        )
        temp_pdf.replace(output_pdf)
    finally:
        temp_pdf.unlink(missing_ok=True)


def main(argv: list[str]) -> int:
    try:
        args = parse_args(argv)
        document = DOC_TYPES[args.doc_type]
        document_title = document["title"]
        output_pdf = Path(args.pdf).resolve() if args.pdf else document["default_pdf"]

        keep_path = Path(args.keep_html).resolve() if args.keep_html else None
        if keep_path == output_pdf:
            raise PdfmakerError("пути --pdf и --keep-html должны различаться")

        config = load_pdfmaker_config()
        toc_order = load_toc_order()
        pages = collect_pages(args.sections, toc_order)
        articles = [clean_article(path, config) for path in pages]
        if keep_path is not None:
            keep_path.parent.mkdir(parents=True, exist_ok=True)
            keep_path.write_text(build_html(document_title, articles), encoding="utf-8")

        render_pdf_atomically(
            document_title,
            articles,
            output_pdf,
            wide_table_mode=args.wide_table_mode,
        )

        print(f"PDF создан: {output_pdf}")
        return 0
    except PdfmakerError as exc:
        print(f"Ошибка: {exc}", file=sys.stderr)
        return 1
    except ModuleNotFoundError as exc:
        package = exc.name or "неизвестный пакет"
        print(f"Ошибка: для работы pdfmaker нужен Python-пакет {package}.", file=sys.stderr)
        return 2
    except OSError as exc:
        print(f"Ошибка ввода-вывода: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
